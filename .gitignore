# Secrets — never commit
.env
.env.*
!.env.example
admin_password.txt
console_port.txt
session_secret.txt
certs/
*.key
*.pem
*.p12
*.pfx
id_rsa*
credentials*
secrets.*

# Data & logs
# `data/` (no leading slash) matches a data directory at ANY depth — data/,
# src/data/, tests/data/. Keep it that way.
data/
#
# Seed-data exception. ONLY if the data is safe, public, and must be versioned
# for reproducibility, uncomment all three lines below. Do NOT change the
# `data/` line above to `data/*` — that would only match the repo root and
# silently un-ignore every nested data directory. And do NOT stop after
# `!/data/` — that re-includes real data too. All three, exactly as written:
# !/data/
# /data/*
# !/data/seed/
*.log
*.sqlite
*.db

# Dependencies
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
target/

# Build output
dist/
build/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# NOTE: the vendored `sing-box` binary is intentionally NOT ignored. Shipping it
# is what lets `install.sh` work without outbound network access; see
# DECISIONS.md, 2026-09-12.
