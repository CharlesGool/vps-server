[Unit]
Description=vps-server unified sing-box nodes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/sing-box-vps-server run -c /etc/vps-server-nodes/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/etc/vps-server-nodes

[Install]
WantedBy=multi-user.target
