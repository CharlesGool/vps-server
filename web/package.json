  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview",
    "check:design": "node scripts/check-design.mjs",
    "check:types": "vue-tsc --noEmit",
