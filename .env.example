# Copy this file to .env before a fresh install; the installer keeps that
# configuration under the persistent state directory.
# Every variable below already has a working default, so an empty .env — or no
# .env at all — is a valid configuration.
#
# Never put a real credential, connection string, personal path, or internal
# hostname in this file. Placeholders only.
#
# The VPSSRV_ prefix is deliberate: vps-webserver owns VPSWS_ and Anytsl-Serve
# owns ANYTLS_, and all three can be installed on one host. A shared prefix
# would let one project's .env silently reconfigure another.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Install root. Only replaceable code and assets live here.
#
# NOTE: this one is NOT read from .env. It is an argument to the installer and
# the uninstaller, which read a bare `PREFIX`, and it has to be, because the
# path is needed before there is an install to read a .env from:
#
#   sudo PREFIX=/srv/vpssrv bash deploy/install.sh
#   sudo PREFIX=/srv/vpssrv bash deploy/uninstall.sh
#
# It is listed here so the value is documented in one place; setting it in
# .env has no effect on anything.
PREFIX=/root/apps/vps-server

# Persistent state root. Set this in the installer environment before the
# first installation; changing it inside .env does not relocate state.
VPSSRV_STATE_DIR=/var/lib/vps-server

# SQLite visitor database and session-signing secret; empty uses
# $VPSSRV_STATE_DIR/data.
VPSSRV_DATA_DIR=

# Self-signed certificate and key; empty uses $VPSSRV_STATE_DIR/certs.
VPSSRV_CERT_DIR=

# ---------------------------------------------------------------------------
# Public reachability page — no authentication, anyone can reach it
# ---------------------------------------------------------------------------

# Set to 1 to serve public pages; fresh installs keep them disabled.
VPSSRV_PUBLIC_ENABLE=0

# Plaintext and TLS ports for the public page. Binding these requires root.
# The installer refuses to proceed if either is already held by another process.
VPSSRV_PUBLIC_HTTP_PORT=80
VPSSRV_PUBLIC_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Console — password-protected, on a hard-to-guess port
# ---------------------------------------------------------------------------

# Bind address for every listener. 0.0.0.0 means all interfaces.
VPSSRV_HOST=0.0.0.0

# 0 means: pick a random port in 20000-59999 on first run and remember it.
# Set a specific port to pin it.
VPSSRV_CONSOLE_PORT=0
# Empty uses $VPSSRV_STATE_DIR/console_port.txt.
VPSSRV_CONSOLE_PORT_FILE=

# Serve the console over HTTPS as well. Off by default: the console is usually
# reached over an SSH tunnel or from a trusted network, and a self-signed
# warning on every visit trains the wrong habit.
VPSSRV_CONSOLE_TLS=0

# 0 disables the login entirely, leaving only the unguessable port as
# protection. Only sensible on a host nobody else can route to.
VPSSRV_AUTH=1

# Plaintext password file, generated on first run if absent. The console's
# access settings can change it after checking the current password.
# Empty uses $VPSSRV_STATE_DIR/admin_password.txt.
VPSSRV_PASSWORD_FILE=

# Optional path for the private-IP allowlist. Empty uses
# $VPSSRV_DATA_DIR/login-access.json (or the app's data directory).
VPSSRV_IP_ALLOWLIST_FILE=

# Login rate limiting — defensive depth, not a fix for a real hole (the
# generated password is already far out of brute-force reach). An IP that
# fails this many times within the window is locked out for the lockout
# duration; a lockout clears on a correct login or by waiting it out.
VPSSRV_LOGIN_MAX_ATTEMPTS=5
VPSSRV_LOGIN_WINDOW_SECONDS=60
VPSSRV_LOGIN_LOCKOUT_SECONDS=30

# Use your own certificate instead of the generated self-signed one — for
# example certbot output. Leave both empty to use the generated pair.
VPSSRV_TLS_CERT=
VPSSRV_TLS_KEY=

# ---------------------------------------------------------------------------
# iperf3 window
# ---------------------------------------------------------------------------

# 0 removes the iperf3 control from the console entirely.
VPSSRV_IPERF_ENABLE=1

# Port an open window listens on. 5201 is the iperf3 default, so testers can
# omit -p.
VPSSRV_IPERF_PORT=5201

# Duration pre-filled in the console, and the ceiling it will not exceed.
# A window always closes itself; there is no "until I stop it" option.
VPSSRV_IPERF_DEFAULT_MINUTES=10
VPSSRV_IPERF_MAX_MINUTES=60

# ---------------------------------------------------------------------------
# Port forwarding — console-managed iptables DNAT rules
# ---------------------------------------------------------------------------

# 0 removes the port-forwarding page and refuses new forwards. Rules already
# applied to iptables from a previous run are left as they are, not withdrawn
# — this only stops the console from managing new ones.
VPSSRV_PORTFWD_ENABLE=1

# Ceiling on how many forwards can be configured at once.
VPSSRV_PORTFWD_MAX_RULES=20

# ---------------------------------------------------------------------------
# Visitor logging and speed testing
# ---------------------------------------------------------------------------

# Poll /proc/net/tcp[6] so connections to ANY port are recorded, not just HTTP.
VPSSRV_TRACK_CONNECTIONS=1
VPSSRV_CONN_POLL_SECONDS=5

# Honour X-Forwarded-For when recording a visitor's address. Only enable this
# behind a reverse proxy you control — otherwise any client can forge its IP.
VPSSRV_TRUST_PROXY=0

# Ceiling on a single browser speedtest transfer, in megabytes.
VPSSRV_MAX_TEST_MB=200

# Speed-test tuning, following LibreSpeed's methodology: several parallel
# streams, a duration-based measurement window, and a warmup whose bytes are
# discarded so TCP slow-start does not drag the number down. Raise
# VPSSRV_TEST_SECONDS on a link too fast to saturate in ten seconds.
VPSSRV_TEST_SECONDS=10
VPSSRV_WARMUP_SECONDS=2
VPSSRV_DOWNLOAD_STREAMS=6
VPSSRV_UPLOAD_STREAMS=3
VPSSRV_PING_SAMPLES=20

# Web interface and installer language: en, zh_cn, or es.
VPSSRV_DEFAULT_LANG=en

# ---------------------------------------------------------------------------
# Unified proxy module — five protocols in one sing-box service
# ---------------------------------------------------------------------------
# Comma-separated subset of anytls,vmess,vless,trojan,shadowsocks. Empty
# means all five; unknown names are rejected.
PROXY_PROTOCOLS=

# Initial TLS SNI shared by vmess, vless, and trojan. The console can later
# give each TLS node its own SNI and certificate.
PROXY_SNI=www.bing.com

# Initial ports and credentials. Empty selects a free port and generates a
# credential. Managed nodes can later be edited independently in the console.
PROXY_ANYTLS_PORT=
PROXY_ANYTLS_PASSWORD=
PROXY_VMESS_PORT=
PROXY_VMESS_UUID=
PROXY_VLESS_PORT=
PROXY_VLESS_UUID=
PROXY_TROJAN_PORT=
PROXY_TROJAN_PASSWORD=
PROXY_SS_PORT=
PROXY_SS_PASSWORD=

# Where the console reads installed proxy configuration. Managed edits use the
# privileged node controller; change the installed protocol set with the
# setup script. VPSSRV_-prefixed because the console reads these settings.
VPSSRV_PROXY_CONFIG=/etc/vps-server-proxy/config.json
VPSSRV_PROXY_SERVICE=vps-server-proxy.service
